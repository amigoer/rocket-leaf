{
  "name": "mq-studio",
  "version": "0.0.9",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wails3 task dev",
    "generate:bindings": "wails3 generate bindings -clean=true -ts",
    "build": "wails3 task build",
    "package": "wails3 task package",
    "check:version": "node scripts/check-version.mjs",
    "check:refs": "node scripts/check-refs.mjs",
    "labels:sync": "node scripts/sync-labels.mjs",
    "go:fmt:check": "bash -c 'files=$(gofmt -l . ); [ -z \"$files\" ] || { echo \"The following Go files are not gofmt-clean:\"; echo \"$files\"; echo \"Run: gofmt -w .\"; exit 1; }'",
    "go:vet": "go vet ./...",
    "frontend:type-check": "npm --prefix frontend run type-check",
    "build:frontend": "npm --prefix frontend run build",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "test": "npm run test:go && npm run test:frontend",
    "test:go": "go test ./...",
    "test:cover": "go test -coverprofile=coverage.out ./... && go tool cover -func=coverage.out | tail -n 1",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e": "MQ_STUDIO_E2E=1 go test -count=1 -run 'TestLive|TestPlainBroker' ./internal/app/... ./internal/driver/rocketmq/... ./internal/driver/rabbitmq/... ./internal/driver/kafka/... ./internal/driver/pulsar/... ./internal/driver/redisstream/... ./internal/driver/mqtt/... ./internal/driver/nats/... ./internal/driver/activemq/...",
    "e2e:up": "docker compose -f tests/e2e/rocketmq/compose.yaml up -d --wait",
    "e2e:seed": "bash scripts/e2e-seed.sh",
    "e2e:acl:up": "bash tests/e2e/rocketmq-acl/up.sh",
    "e2e:acl:down": "docker compose -f tests/e2e/rocketmq-acl/compose.yaml down -v",
    "e2e:rabbitmq:up": "docker compose -f tests/e2e/rabbitmq/compose.yaml up -d --wait",
    "e2e:rabbitmq:seed": "bash scripts/e2e-rabbitmq-seed.sh",
    "e2e:rabbitmq:plain:up": "docker compose -f tests/e2e/rabbitmq-plain/compose.yaml up -d --wait",
    "e2e:rabbitmq:plain:down": "docker compose -f tests/e2e/rabbitmq-plain/compose.yaml down -v",
    "e2e:kafka:up": "docker compose -f tests/e2e/kafka/compose.yaml up -d --wait",
    "e2e:kafka:seed": "bash scripts/e2e-kafka-seed.sh",
    "e2e:kafka:down": "docker compose -f tests/e2e/kafka/compose.yaml down -v",
    "e2e:kafka:secure:up": "docker compose -f tests/e2e/kafka-secure/compose.yaml up -d --wait",
    "e2e:kafka:secure:down": "docker compose -f tests/e2e/kafka-secure/compose.yaml down -v",
    "e2e:pulsar:up": "docker compose -f tests/e2e/pulsar/compose.yaml up -d --wait",
    "e2e:pulsar:seed": "bash scripts/e2e-pulsar-seed.sh",
    "e2e:pulsar:down": "docker compose -f tests/e2e/pulsar/compose.yaml down -v",
    "e2e:redis:up": "docker compose -f tests/e2e/redis/compose.yaml up -d --wait",
    "e2e:redis:seed": "bash scripts/e2e-redis-seed.sh",
    "e2e:redis:down": "docker compose -f tests/e2e/redis/compose.yaml down -v",
    "e2e:redis:cluster:up": "docker compose -f tests/e2e/redis-cluster/compose.yaml up -d --wait",
    "e2e:redis:cluster:down": "docker compose -f tests/e2e/redis-cluster/compose.yaml down -v",
    "e2e:mqtt:up": "docker compose -f tests/e2e/mqtt/compose.yaml up -d --wait",
    "e2e:mqtt:down": "docker compose -f tests/e2e/mqtt/compose.yaml down -v",
    "e2e:mqtt:emqx:up": "docker compose -f tests/e2e/mqtt-emqx/compose.yaml up -d --wait",
    "e2e:mqtt:emqx:down": "docker compose -f tests/e2e/mqtt-emqx/compose.yaml down -v",
    "e2e:nats:up": "docker compose -f tests/e2e/nats/compose.yaml up -d --wait",
    "e2e:nats:seed": "bash scripts/e2e-nats-seed.sh",
    "e2e:nats:down": "docker compose -f tests/e2e/nats/compose.yaml down -v",
    "e2e:nats:plain:up": "docker compose -f tests/e2e/nats-plain/compose.yaml up -d --wait",
    "e2e:nats:plain:down": "docker compose -f tests/e2e/nats-plain/compose.yaml down -v",
    "e2e:activemq:up": "docker compose -f tests/e2e/activemq/compose.yaml up -d --wait",
    "e2e:activemq:seed": "bash scripts/e2e-activemq-seed.sh",
    "e2e:activemq:down": "docker compose -f tests/e2e/activemq/compose.yaml down -v",
    "e2e:activemq:classic:up": "docker compose -f tests/e2e/activemq-classic/compose.yaml up -d --wait",
    "e2e:activemq:classic:down": "docker compose -f tests/e2e/activemq-classic/compose.yaml down -v",
    "e2e:down": "docker compose -f tests/e2e/rocketmq/compose.yaml down -v",
    "e2e:rabbitmq:down": "docker compose -f tests/e2e/rabbitmq/compose.yaml down -v",
    "check:bindings": "npm run generate:bindings && git diff --quiet -- frontend/bindings || (echo 'Generated bindings are stale; run npm run generate:bindings and commit the result.' >&2 && git diff --stat -- frontend/bindings && exit 1)",
    "check": "npm run check:version && npm run check:refs && npm run build:frontend && npm run go:fmt:check && npm run go:vet && npm test && npm run check:bindings"
  }
}
