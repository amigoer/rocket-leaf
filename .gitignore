# Build output
bin/
frontend/dist/
frontend/node_modules/
frontend/*.tsbuildinfo
node_modules/

# Website build output. src/data/release.json is generated too but stays
# tracked: it is the offline fallback that lets the download page build when the
# GitHub API is rate-limited or unreachable. The screenshots are read straight
# out of docs/images/readme through an alias, so there is no copy to ignore.
website/node_modules/
website/dist/
website/.astro/

# Go coverage profiles, written by `npm run test:cover` and by CI
coverage*.out

# Task's local checksum cache
.task/

# Machine-local Go workspace; go.mod is the committed source of truth
go.work
go.work.sum

# Copied from build/linux/desktop by the linux:generate:dotdesktop task
build/linux/mq-studio.desktop

# Generated by `wails3 task icons` from build/appicon.png
build/darwin/icons.icns
build/darwin/Assets.car
build/windows/icon.ico

# `wails3 update build-assets` recreates this; the app does not target iOS
build/ios/

# IDE / OS files
.idea/
.vscode/
.cursor/
.cursorrules
.DS_Store
**/.DS_Store

.claude/

# The ACL E2E broker rewrites this; the tracked template is plain_acl.seed.yml.
tests/e2e/rocketmq-acl/plain_acl.yml
